DATABASE_URL=postgresql://fit_trace:fit_trace@localhost:5432/fit_trace?schema=public
JWT_SECRET=replace-with-a-long-random-secret
# 访问令牌以秒为单位，15 分钟；App 登录会话由服务端持久保存，自动续期。
JWT_EXPIRES_IN_SECONDS=900

# QQ 邮箱：在邮箱设置中开启 SMTP，SMTP_PASS 使用授权码，不是登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 阿里云验证码 2.0：开通并创建 V3 场景后再启用；密钥仅供 API 使用。
ALIYUN_CAPTCHA_ENABLED=false
ALIYUN_CAPTCHA_REGION=cn
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_APP_SCENE_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
# 使用反向代理时，只信任明确的代理地址/CIDR；留空时不信任转发头。
TRUST_PROXY=

# AI 识别：mock = 内置模拟识别（不分析图片，仅用于打通流程）
#          openai = 真实视觉识别（兼容 OpenAI 协议的服务），需要配置 AI_API_KEY
AI_PROVIDER=mock
AI_API_KEY=
# 示例：硅基流动
AI_MODEL=Qwen/Qwen3-VL-32B-Instruct
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_TIMEOUT_MS=45000
# responses = OpenAI 官方；chat = 硅基流动 / 通义 / 智谱 / 豆包等兼容端点
AI_API_MODE=chat
# json_schema 能约束字段名，最不容易丢数据；服务不支持时退回 json_object 或 none
AI_RESPONSE_FORMAT=json_schema

STORAGE_PROVIDER=local
# 相对路径按启动时的工作目录解析；放在仓库内也可以，
# 但必须保持 .gitignore 里的 uploads/ 忽略规则，避免照片被提交
# 新图片按 Asia/Shanghai 上传日期存入 年/月/日/用户ID/，旧图片保留原路径
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_PREFIX=/uploads
STORAGE_PUBLIC_URL=http://10.0.3.54:3000
API_PORT=3000
API_HOST=0.0.0.0
# 留空保持开发环境跨域；生产填写 H5 域名。
CORS_ORIGINS=
VITE_API_BASE_URL=http://10.0.3.54:3000/api/v1

# H5 错误上报：留空 DSN 或设为 false 可关闭
VITE_GLITCHTIP_DSN=https://74f021de9c014807a656c8f160bc2e05@glitchtip.moshangl.cn/2
VITE_GLITCHTIP_ENABLED=true
# 可选发布标识，留空自动使用 Git 提交标识；H5 与 source map 使用同一个值
VITE_GLITCHTIP_RELEASE=
# Vite 构建时自动上传 source map；启用监控时必须配置 token，禁止使用 VITE_ 前缀
SENTRY_URL=https://glitchtip.moshangl.cn
SENTRY_ORG=yuwenovo
SENTRY_PROJECT=fittrace
SENTRY_AUTH_TOKEN=
# false 跳过源码映射生成与上传，运行时错误上报仍由 VITE_GLITCHTIP_ENABLED 控制。
GLITCHTIP_UPLOAD_SOURCEMAPS=true

# 设为 true 时额外打印 Nest 的路由与依赖装载日志
LOG_VERBOSE=false
