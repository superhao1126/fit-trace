{
  "name": "fit-trace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "concurrently -n h5,api -c cyan,green \"pnpm dev:h5\" \"pnpm dev:api\"",
    "dev:h5": "pnpm --filter @fit-trace/h5 dev",
    "dev:api": "pnpm --filter @fit-trace/api dev",
    "build": "pnpm -r --if-present build",
    "build:h5": "pnpm --filter @fit-trace/h5 build",
    "preview:h5": "pnpm --filter @fit-trace/h5 preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ox": "oxlint apps packages",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm lint:ox && pnpm typecheck",
    "dev:mp": "pnpm --filter @fit-trace/miniprogram dev",
    "build:mp": "pnpm --filter @fit-trace/miniprogram build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.43.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
