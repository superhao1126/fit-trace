generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  hasPassword    Boolean?
  tokenVersion   Int             @default(0)
  nickname       String?
  avatarUrl      String?
  gender         UserGender      @default(UNSPECIFIED)
  goalType       FitnessGoalType?
  goalStartWeight Decimal?        @db.Decimal(6, 2)
  targetWeight   Decimal?         @db.Decimal(6, 2)
  targetDate     DateTime?
  goalStartedAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bodyRecords    BodyRecord[]
  mealRecords    MealRecord[]
  mealFavorites  MealFavorite[]
  workoutRecords WorkoutRecord[]
  progressPhotos ProgressPhoto[]
  authSessions   AuthSession[]
  trainingTemplates TrainingTemplate[]
  trainingPlan TrainingPlan?

  @@map("users")
}

// 每次登录创建独立设备会话；没有定期到期时间，退出或密码重置后不可再续期。
model AuthSession {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  tokenVersion Int
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

enum EmailCodePurpose {
  REGISTER
  RESET_PASSWORD
  LOGIN
}

model EmailVerification {
  id         String           @id @default(uuid())
  email      String
  purpose    EmailCodePurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int              @default(0)
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@unique([email, purpose])
  @@index([expiresAt])
  @@map("email_verifications")
}

model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model LoginCaptchaChallenge {
  id         String   @id @default(uuid())
  codeHash   String
  ipHash     String
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([expiresAt])
  @@map("login_captcha_challenges")
}

enum FitnessGoalType {
  LOSE_FAT
  GAIN_MUSCLE
  MAINTAIN
}

enum UserGender {
  UNSPECIFIED
  MALE
  FEMALE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model BodyRecord {
  id         String   @id @default(uuid())
  userId     String
  weight     Decimal  @db.Decimal(6, 2)
  bodyFat    Decimal? @db.Decimal(5, 2)
  waist      Decimal? @db.Decimal(6, 2)
  chest      Decimal? @db.Decimal(6, 2)
  hip        Decimal? @db.Decimal(6, 2)
  recordedAt DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("body_records")
}

model MealRecord {
  id         String   @id @default(uuid())
  userId     String
  type       MealType
  recordedAt DateTime
  note       String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  foods FoodItem[]

  @@index([userId, recordedAt])
  @@map("meal_records")
}

model FoodItem {
  id           String   @id @default(uuid())
  mealRecordId String
  name         String
  amount       String?
  calories     Int?
  aiGenerated  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mealRecord MealRecord @relation(fields: [mealRecordId], references: [id], onDelete: Cascade)

  @@index([mealRecordId])
  @@map("food_items")
}

enum WorkoutType {
  STRENGTH
  CARDIO
  RUNNING
  CYCLING
  SWIMMING
  OTHER
}

model WorkoutRecord {
  id              String      @id @default(uuid())
  userId          String
  type            WorkoutType
  name            String
  startedAt       DateTime
  durationMinutes Int
  calories        Int?
  note            String?
  exercises       Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("workout_records")
}

model TrainingTemplate {
  id String @id @default(uuid())
  userId String
  name String
  durationMinutes Int
  exercises Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("training_templates")
}

model TrainingPlan {
  id String @id @default(uuid())
  userId String @unique
  days Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("training_plans")
}

enum PhotoType {
  FRONT
  SIDE
  BACK
  OTHER
}

model ProgressPhoto {
  id         String    @id @default(uuid())
  userId     String
  type       PhotoType
  imageUrl   String
  recordedAt DateTime
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("progress_photos")
}

// 常用餐保存独立快照，删除或编辑原记录不会改变搭配。
model MealFavorite {
  id        String   @id @default(uuid())
  userId    String
  name      String
  foods     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("meal_favorites")
}
